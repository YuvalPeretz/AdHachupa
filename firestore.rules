rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ─────────────────────────────────────────────────────

    function isAuthed() {
      return request.auth != null;
    }

    // Reads users/{uid} to resolve the caller's coupleId.
    // This single-document lookup replaces the old uid==coupleId assumption.
    function callerCoupleId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coupleId;
    }

    // True when the caller belongs to the given couple.
    function isMember(coupleId) {
      return isAuthed() && callerCoupleId() == coupleId;
    }

    // For create: the new doc's coupleId must match the caller's couple.
    function creatingAsMember() {
      return isAuthed() && request.resource.data.coupleId == callerCoupleId();
    }

    // For update: prevents reassigning coupleId to a different couple.
    function keepsCoupleId() {
      return request.resource.data.coupleId == resource.data.coupleId;
    }

    // ─── users ────────────────────────────────────────────────────────────────
    // doc id == Firebase Auth uid. Maps a user to their couple.
    // Created client-side during onboarding (partner 1) or by the
    // acceptCoupleInvite Cloud Function (partner 2).
    match /users/{uid} {
      allow read:   if isAuthed() && request.auth.uid == uid;
      allow create: if isAuthed() && request.auth.uid == uid;
      allow update: if false; // CF only (acceptCoupleInvite Admin SDK)
      allow delete: if false;
    }

    // ─── couples ──────────────────────────────────────────────────────────────
    // doc id == auto-generated coupleId (NOT the uid).
    // Created atomically by the `onboarding` Cloud Function.
    match /couples/{coupleId} {
      allow read:   if isMember(coupleId);
      allow create: if false; // CF only
      allow update: if isMember(coupleId);
      allow delete: if false;
    }

    // ─── coupleInvites ────────────────────────────────────────────────────────
    // doc id == invite token (UUID, acts as a capability URL).
    // Any authenticated user can read (to validate before joining).
    // Only a couple member can create an invite for their own couple.
    // Accepting is done by the acceptCoupleInvite Cloud Function (Admin SDK).
    match /coupleInvites/{token} {
      allow read:   if isAuthed();
      allow create: if isAuthed() && request.resource.data.coupleId == callerCoupleId()
                       && request.resource.data.createdByUid == request.auth.uid;
      allow update: if false; // CF only
      allow delete: if false;
    }

    // ─── events ───────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read:   if isMember(resource.data.coupleId);
      allow create: if creatingAsMember();
      allow update: if isMember(resource.data.coupleId) && keepsCoupleId();
      allow delete: if false;
    }

    // ─── guests ───────────────────────────────────────────────────────────────
    match /guests/{guestId} {
      allow read:   if isMember(resource.data.coupleId);
      allow create: if creatingAsMember();
      allow update: if isMember(resource.data.coupleId) && keepsCoupleId();
      allow delete: if isMember(resource.data.coupleId);
    }

    // ─── dismissedDuplicates ─────────────────────────────────────────────────
    match /dismissedDuplicates/{id} {
      allow read:   if isMember(resource.data.coupleId);
      allow create: if creatingAsMember();
      allow delete: if isMember(resource.data.coupleId);
      allow update: if false;
    }

    // ─── tasks ────────────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read:   if isMember(resource.data.coupleId);
      allow create: if creatingAsMember();
      allow update: if isMember(resource.data.coupleId) && keepsCoupleId();
      allow delete: if isMember(resource.data.coupleId);
    }

    // ─── task sub-type detail documents ──────────────────────────────────────
    match /taskPayments/{taskId} {
      allow read:   if isMember(resource.data.coupleId);
      allow create: if creatingAsMember();
      allow update: if isMember(resource.data.coupleId) && keepsCoupleId();
      allow delete: if isMember(resource.data.coupleId);
    }

    match /taskVendorConfigs/{taskId} {
      allow read:   if isMember(resource.data.coupleId);
      allow create: if creatingAsMember();
      allow update: if isMember(resource.data.coupleId) && keepsCoupleId();
      allow delete: if isMember(resource.data.coupleId);
    }

    match /taskDecisions/{taskId} {
      allow read:   if isMember(resource.data.coupleId);
      allow create: if creatingAsMember();
      allow update: if isMember(resource.data.coupleId) && keepsCoupleId();
      allow delete: if isMember(resource.data.coupleId);
    }

    match /taskReminders/{taskId} {
      allow read:   if isMember(resource.data.coupleId);
      allow create: if creatingAsMember();
      allow update: if isMember(resource.data.coupleId) && keepsCoupleId();
      allow delete: if isMember(resource.data.coupleId);
    }

    // ─── vendors ──────────────────────────────────────────────────────────────
    match /vendors/{vendorId} {
      allow read:   if isMember(resource.data.coupleId);
      allow create: if creatingAsMember();
      allow update: if isMember(resource.data.coupleId) && keepsCoupleId();
      allow delete: if isMember(resource.data.coupleId);
    }

    // ─── budget ───────────────────────────────────────────────────────────────
    match /budget/{coupleId} {
      allow read:   if isMember(coupleId);
      allow create: if false; // CF only
      allow update: if isMember(coupleId);
      allow delete: if false;
    }

    // ─── budgetExpenses ───────────────────────────────────────────────────────
    match /budgetExpenses/{expenseId} {
      allow read:   if isMember(resource.data.coupleId);
      allow create: if creatingAsMember();
      allow update: if isMember(resource.data.coupleId) && keepsCoupleId();
      allow delete: if isMember(resource.data.coupleId);
    }

    // ─── guestGifts ───────────────────────────────────────────────────────────
    match /guestGifts/{giftId} {
      allow read:   if isMember(resource.data.coupleId);
      allow create: if creatingAsMember();
      allow update: if isMember(resource.data.coupleId) && keepsCoupleId();
      allow delete: if isMember(resource.data.coupleId);
    }

    // ─── scheduledNotifications ───────────────────────────────────────────────
    match /scheduledNotifications/{notifId} {
      allow read:  if isMember(resource.data.coupleId);
      allow write: if false;
    }

    // ─── shareTokens ─────────────────────────────────────────────────────────
    // allow read: if true is intentional — token UUID is a capability.
    match /shareTokens/{token} {
      allow read:   if true;
      allow create: if isAuthed() && request.resource.data.coupleId == callerCoupleId();
      allow update: if false;
      allow delete: if false;
    }

    // ─── Catch-all ────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
